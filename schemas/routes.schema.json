{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkononion-ui-ux.local/schemas/routes.schema.json",
  "title": "Request routes",
  "description": "Routing table used by scripts/route.mjs: weighted trigger patterns per route, always-loaded modules, keyword modifiers, approval triggers, untrusted-instruction warning patterns and the fallback route. Patterns are case-insensitive JavaScript regular expression sources.",
  "type": "object",
  "required": ["version", "always", "routes", "fallback"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "version": { "type": ["string", "integer"] },
    "description": { "type": "string" },
    "always": {
      "description": "Modules loaded for every request (reference ids such as \"quality-gates\" or relative paths).",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "patterns", "modules"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "patterns": { "$ref": "#/$defs/patterns" },
          "weight": { "type": "number", "minimum": 0 },
          "modules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "note": { "type": "string" }
        }
      }
    },
    "approvalTriggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "patterns", "note"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "patterns": { "$ref": "#/$defs/patterns" },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "warningPatterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "patterns"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "patterns": { "$ref": "#/$defs/patterns" },
          "note": { "type": "string" }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    },
    "fallback": {
      "description": "Route id used when nothing scores >= 1, or an object naming the fallback route/workflow/modules.",
      "anyOf": [
        { "$ref": "#/$defs/id" },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "route": { "$ref": "#/$defs/id" },
            "workflow": { "type": "string", "minLength": 1 },
            "modules": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "patterns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "route": {
      "type": "object",
      "required": ["id", "workflow", "triggers", "modules"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "workflow": { "type": "string", "minLength": 1, "description": "Workflow id (workflows/<id>.md) or relative path." },
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pattern", "weight"],
            "properties": {
              "pattern": { "type": "string", "minLength": 1 },
              "weight": { "type": "number", "minimum": 1, "maximum": 3 }
            }
          }
        },
        "modules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "delegateSkills": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "presets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "note": { "type": "string" }
      }
    }
  }
}
