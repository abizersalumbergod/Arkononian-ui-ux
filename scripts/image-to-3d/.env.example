# Optional Gemini stage (scripts/image-to-3d/gemini_media.py). PLACEHOLDERS ONLY: this file never holds a real key.
#
# How to use it: copy this file to `.env` in YOUR PROJECT (not in the skill), fill it in, keep `.env` out of git,
# and pass `--env-file .env` to gemini_media.py / image_to_glb.py doctor, or export the variables in your shell.
# Variables already set in the process environment win over this file.
#
# Who needs it: only people with Gemini API access. Google lists its image and video models as paid-only
# (checked 2026-10-29), so the key's project needs billing enabled. Without it, leave everything unset and the skill
# uses the normal procedure (a user-supplied image, licensed retrieval, procedural assets, other generators).

# A Gemini API key from Google AI Studio. Never paste it into chat, SKILL.md, source files or logs.
GEMINI_API_KEY=your-api-key-here

# Model ids are configuration, not code: Google retires and renames models (the Veo 3.1 previews were shut down
# on 2026-10-22). Take current ids from Google's docs. Suggested on 2026-10-29: gemini-nano-banana-2.1 for images,
# gemini-omni-1.1-flash for video.
GEMINI_IMAGE_MODEL=your-image-model-id
GEMINI_VIDEO_MODEL=your-video-model-id

# Optional guard rails
# GEMINI_MAX_JOBS_PER_RUN=4        # paid jobs allowed per command (default 4 images, 1 video)
# GEMINI_TIMEOUT_SECONDS=120       # per HTTP request
