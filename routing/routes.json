      "modules": ["references/video-pipelines.md"]
    },
    {
      "id": "image",
      "patterns": ["\\b(images?|imagery|photos?|photograph(s|y)|pictures?|illustrations?|galler(y|ies)|thumbnails?|avif|webp|jpe?g|png|svgs?)\\b"],
      "modules": ["references/image-pipelines.md"]
    },
    {
      "id": "audio",
      "patterns": [
        "\\baudio\\b(?![\\s-](hardware|equipment|gear|brands?|company|companies|store|shop|products?|devices?)\\b)",
        "\\b(music|sound (effects?|design)|sfx|soundtracks?|voice[\\s-]?overs?|narration|podcasts?|jingles?|ambient (sound|audio))\\b"
      ],
      "modules": ["references/audio-pipelines.md"]
    },
    {
      "id": "data-visualisation",
