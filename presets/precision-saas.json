{
  "$schema": "../schemas/preset.schema.json",
  "$comment": "Neutral zinc greys with one blue accent reserved for primary actions, focus and selection. Numbers in tables and KPIs use the mono role or font-variant-numeric: tabular-nums. The numeric space keys reproduce a 4 px grid (Tailwind's default --spacing of 0.25rem matches them); the named keys are density sizes for rows, controls and the sidebar.",
  "name": "precision-saas",
  "description": "Dense, neutral product UI for dashboards and SaaS apps: zinc greys, a single blue accent, Inter for text with JetBrains Mono for tabular numbers, a 4 px spacing grid, small radii, subtle shadows and quick 120-200 ms motion. Light and dark palettes.",
  "intendedFor": [
    "SaaS application UI and admin panels",
    "analytics dashboards, data tables and reporting",
    "internal tools, CRMs and back-office CRUD",
    "developer tools and settings-heavy products",
    "documentation and pricing pages for these products"
  ],
  "notFor": [
    "brand-led marketing sites that need a strong visual signature",
    "editorial or portfolio storytelling",
    "emotional consumer brands (food, fashion, hospitality)"
  ],
  "color": {
    "light": {
      "background": "#FAFAFA",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "surfaceSunken": "#F4F4F5",
      "text": "#18181B",
      "textMuted": "#52525B",
      "textSubtle": "#6B6B74",
      "border": "#E4E4E7",
      "borderStrong": "#8A8A93",
      "accent": "#3358D4",
      "accentHover": "#2A48B3",
      "accentContrast": "#FFFFFF",
      "accentSubtle": "#EEF2FF",
      "focusRing": "#3358D4",
      "success": "#067647",
      "warning": "#B54708",
      "danger": "#B42318"
    },
    "dark": {
      "background": "#09090B",
      "surface": "#111113",
      "surfaceRaised": "#18181B",
      "surfaceSunken": "#050506",
      "text": "#FAFAFA",
      "textMuted": "#A1A1AA",
      "textSubtle": "#8B8B94",
      "border": "#27272A",
      "borderStrong": "#6E6E77",
      "accent": "#7B93FF",
      "accentHover": "#94A8FF",
      "accentContrast": "#09090B",
      "accentSubtle": "#1A2140",
      "focusRing": "#7B93FF",
      "success": "#47CD89",
      "warning": "#FDB022",
      "danger": "#F97066"
    }
  },
  "typography": {
    "display": {
      "family": "Inter",
      "fallback": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
      "weights": [600, 700],
      "source": "Google Fonts",
      "license": "OFL-1.1"
    },
    "text": {
      "family": "Inter",
      "fallback": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
      "weights": [400, 500, 600],
      "source": "Google Fonts",
      "license": "OFL-1.1"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"],
      "weights": [400, 500],
      "source": "Google Fonts",
      "license": "OFL-1.1"
    },
    "scale": {
      "xs": "0.75rem",
      "sm": "0.8125rem",
      "base": "0.875rem",
      "lg": "1rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "display": "1.875rem"
    },
    "lineHeights": {
      "xs": "1rem",
      "sm": "1.25rem",
      "base": "1.25rem",
      "lg": "1.5rem",
      "xl": "1.75rem",
      "2xl": "2rem",
      "display": "2.25rem",
      "tight": 1.2,
      "normal": 1.5
    },
    "tracking": {
      "display": "-0.02em",
      "tight": "-0.01em",
      "normal": "0em",
      "caps": "0.04em"
    }
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "full": "9999px"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "rowCompact": "1.75rem",
    "row": "2.25rem",
    "control": "2rem",
    "gutter": "1rem",
    "sidebar": "15rem"
  },
  "shadow": {
    "xs": "0 1px 2px 0 rgb(9 9 11 / 0.05)",
    "sm": "0 1px 3px 0 rgb(9 9 11 / 0.08), 0 1px 2px -1px rgb(9 9 11 / 0.06)",
    "md": "0 4px 8px -2px rgb(9 9 11 / 0.08), 0 2px 4px -2px rgb(9 9 11 / 0.05)",
    "lg": "0 12px 24px -6px rgb(9 9 11 / 0.14), 0 4px 8px -4px rgb(9 9 11 / 0.06)"
  },
  "motion": {
    "durations": {
      "fast": "120ms",
      "base": "160ms",
      "slow": "200ms"
    },
    "easings": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)"
    }
  },
  "contrastPairs": [
    { "fg": "text", "bg": "background", "min": 4.5 },
    { "fg": "text", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "text", "bg": "surfaceSunken", "min": 4.5 },
    { "fg": "textMuted", "bg": "background", "min": 4.5, "note": "secondary labels and table metadata" },
    { "fg": "textMuted", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "textSubtle", "bg": "surface", "min": 4.5, "note": "placeholder-like hints and timestamps" },
    { "fg": "textSubtle", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "accent", "bg": "background", "min": 4.5, "note": "links and accent text" },
    { "fg": "accent", "bg": "surface", "min": 4.5 },
    { "fg": "accentContrast", "bg": "accent", "min": 4.5, "note": "primary button label" },
    { "fg": "accentContrast", "bg": "accentHover", "min": 4.5 },
    { "fg": "text", "bg": "accentSubtle", "min": 4.5, "note": "selected row or active nav item" },
    { "fg": "focusRing", "bg": "surface", "min": 3, "note": "focus indicator (WCAG 2.4.13 / 1.4.11)" },
    { "fg": "borderStrong", "bg": "surface", "min": 3, "note": "input and control boundaries (WCAG 1.4.11)" },
    { "fg": "borderStrong", "bg": "background", "min": 3 },
    { "fg": "success", "bg": "surface", "min": 4.5 },
    { "fg": "warning", "bg": "surface", "min": 4.5 },
    { "fg": "danger", "bg": "surface", "min": 4.5 }
  ]
}
