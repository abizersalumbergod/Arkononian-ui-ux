{
  "$schema": "../schemas/preset.schema.json",
  "$comment": "Derived from ../../cinematic-noir-studio/SKILL.md (sections 2 and 4). Accessibility adjustments, which take precedence over the reference: accentContrast is ink (#0A0A0A) because white text on the #FF4925 accent stays below 4.5:1; the dark accentHover is lightened to #FF6B4A so ink text stays above 4.5:1 (the reference darkens to #BD2608); borderStrong is the boundary colour for inputs and controls and is lifted to #6B6B6B because the reference line-soft (#555555) is below 3:1 on ink. Status colours and the light palette are additions.",
  "name": "cinematic-noir",
  "description": "Dark-first poster aesthetic: near-black canvas, a single ember accent kept to a few percent of the screen, condensed uppercase display type, 1px hairlines instead of shadows, and expressive easing for scroll choreography. The dark palette is the reference look; pin it with <html data-theme=\"dark\">. The light palette is a daylight variant for print and light-preference contexts.",
  "sourceSkill": "../../cinematic-noir-studio/SKILL.md",
  "intendedFor": [
    "creative studio and agency sites",
    "launch and campaign pages that lead with imagery and motion",
    "film, music, fashion and product-reveal storytelling",
    "portfolio showreels"
  ],
  "notFor": [
    "dense dashboards and data tools",
    "long-form reading and documentation",
    "e-commerce catalogues and checkout flows",
    "brands or audiences that need a calm, light interface by default",
    "products that cannot supply strong imagery"
  ],
  "color": {
    "light": {
      "background": "#F5F5F4",
      "surface": "#EDEDEB",
      "surfaceRaised": "#FFFFFF",
      "text": "#0A0A0A",
      "textMuted": "#5C5C5C",
      "textSoft": "#3D3D3D",
      "border": "#D6D6D3",
      "borderStrong": "#858581",
      "accent": "#BD2608",
      "accentHover": "#9E1F05",
      "accentContrast": "#FFFFFF",
      "accentTint": "#F8E4DF",
      "accentRing": "#BD260840",
      "scrim": "#F5F5F4CC",
      "focusRing": "#BD2608",
      "success": "#15803D",
      "warning": "#A15C07",
      "danger": "#B91C1C"
    },
    "dark": {
      "background": "#0A0A0A",
      "surface": "#181818",
      "surfaceRaised": "#222222",
      "text": "#FFFFFF",
      "textMuted": "#8F8F8F",
      "textSoft": "#CACACA",
      "border": "#333333",
      "borderStrong": "#6B6B6B",
      "accent": "#FF4925",
      "accentHover": "#FF6B4A",
      "accentContrast": "#0A0A0A",
      "accentTint": "#220F0D",
      "accentRing": "#FF492540",
      "scrim": "#0A0A0ACC",
      "focusRing": "#FF4925",
      "success": "#4ADE80",
      "warning": "#FBBF24",
      "danger": "#F87171"
    }
  },
  "typography": {
    "display": {
      "family": "Anton",
      "fallback": ["Impact", "Haettenschweiler", "Arial Narrow Bold", "sans-serif"],
      "weights": [400],
      "source": "Google Fonts",
      "license": "OFL-1.1"
    },
    "text": {
      "family": "Inter",
      "fallback": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
      "weights": [400, 500, 600],
      "source": "Google Fonts",
      "license": "OFL-1.1"
    },
    "mono": {
      "family": "ui-monospace",
      "fallback": ["SFMono-Regular", "Menlo", "Consolas", "monospace"],
      "weights": [400],
      "source": "system",
      "license": "system font, not distributed"
    },
    "scale": {
      "label": "0.6875rem",
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "display": "clamp(3.5rem, 10vw, 8rem)",
      "displaySm": "clamp(2.5rem, 7vw, 4.5rem)",
      "displayLg": "clamp(4rem, 13vw, 12rem)",
      "displayXl": "clamp(5rem, 18vw, 20rem)"
    },
    "lineHeights": {
      "display": 0.92,
      "displaySm": 0.95,
      "displayLg": 0.88,
      "displayXl": 0.85,
      "tight": 1.1,
      "body": 1.625
    },
    "tracking": {
      "display": "0.02em",
      "wide": "0.08em",
      "wider": "0.14em",
      "widest": "0.24em"
    }
  },
  "radius": {
    "none": "0px",
    "card": "12px",
    "cardLg": "16px",
    "glass": "32px",
    "pill": "9999px"
  },
  "space": {
    "gutter": "1.5rem",
    "headerPadLg": "2.5rem",
    "stack": "4rem",
    "section": "7rem",
    "sectionLg": "10rem",
    "container": "1400px"
  },
  "shadow": {
    "glow": "0 0 60px -12px rgb(255 73 37 / 0.25)",
    "glowStrong": "0 0 90px -10px rgb(255 73 37 / 1)",
    "lift": "0 25px 50px -12px rgb(0 0 0 / 0.25)"
  },
  "motion": {
    "durations": {
      "fast": "300ms",
      "base": "500ms",
      "slow": "900ms",
      "image": "700ms",
      "menu": "650ms"
    },
    "easings": {
      "standard": "cubic-bezier(0.44, 0, 0.14, 1)",
      "emphasized": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.32, 0, 0.67, 0)",
      "stairs": "cubic-bezier(0.85, 0, 0.15, 1)"
    }
  },
  "contrastPairs": [
    { "fg": "text", "bg": "background", "min": 4.5 },
    { "fg": "text", "bg": "surface", "min": 4.5 },
    { "fg": "text", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "textMuted", "bg": "background", "min": 4.5, "note": "body and secondary copy" },
    { "fg": "textMuted", "bg": "surface", "min": 4.5 },
    { "fg": "textSoft", "bg": "surfaceRaised", "min": 4.5, "note": "tags and tertiary text on raised panels" },
    { "fg": "accent", "bg": "background", "min": 4.5, "note": "accent used as small text: indices, hover titles, eyebrow dots" },
    { "fg": "accentContrast", "bg": "accent", "min": 4.5, "note": "label on a solid accent button" },
    { "fg": "accentContrast", "bg": "accentHover", "min": 4.5, "note": "label on a hovered or pressed accent button" },
    { "fg": "text", "bg": "accentTint", "min": 4.5, "note": "featured or pricing card" },
    { "fg": "focusRing", "bg": "background", "min": 3, "note": "WCAG 2.2 focus indicator / non-text contrast" },
    { "fg": "borderStrong", "bg": "background", "min": 3, "note": "input and control boundaries (WCAG 1.4.11)" },
    { "fg": "borderStrong", "bg": "surface", "min": 3 },
    { "fg": "success", "bg": "background", "min": 4.5 },
    { "fg": "warning", "bg": "background", "min": 4.5 },
    { "fg": "danger", "bg": "background", "min": 4.5 }
  ]
}
